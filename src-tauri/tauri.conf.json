{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "i18n Editor",
  "version": "0.1.0",
  "identifier": "com.i18neditor.app",
  "build": {
    "frontendDist": ["../i18n-editor.html"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "i18n Editor",
        "width": 1280,
        "height": 860,
        "url": "i18n-editor.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"]
  }
}
